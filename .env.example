# ---------------------------------------------------------------------------
# Rakta-Daan environment template. Copy to .env.local for development.
# Never commit real secrets. See docs/operations/deployment.md.
# ---------------------------------------------------------------------------

# Postgres (docker compose db exposes 127.0.0.1:5435)
DATABASE_URL=postgres://rakta:rakta@127.0.0.1:5435/rakta_daan
# Separate database used by `pnpm test` (created automatically by scripts/setup-test-db.ts)
TEST_DATABASE_URL=postgres://rakta:rakta@127.0.0.1:5435/rakta_daan_test

# Public origin, used for absolute links in messages and for same-origin checks.
APP_URL=http://localhost:3000

# 32+ byte random strings. Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-auth-secret-change-me-0000000000000000
OTP_PEPPER=dev-only-otp-pepper-change-me-00000000000000000
# Protects /api/internal/outbox and other cron endpoints.
CRON_SECRET=dev-only-cron-secret-change-me
# Extra shared secret for webhook verification when the provider has no signature.
WEBHOOK_SECRET=dev-only-webhook-secret-change-me

# Development conveniences. MUST be false in production:
#  - returns the OTP in the API response / on screen so the flow is testable without SMS
#  - enables the seeded demo accounts
DEV_EXPOSE_OTP=true

# messaging: mock | whatsapp | sparrow | whatsapp+sparrow | none
MESSAGING_PROVIDER=mock
MESSAGING_FROM_NAME=Rakta-Daan

# WhatsApp Business Platform (Cloud API). Requires a Meta business account,
# an approved message template and recipient opt-in. See docs/integrations/messaging.md
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_REQUEST=blood_request_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Sparrow SMS (Nepal). Requires an NTA-approved sender ID.
SPARROW_API_URL=https://api.sparrowsms.com/v2/sms/
SPARROW_TOKEN=
SPARROW_SENDER_ID=
