# Application
NODE_ENV=production
PORT=4000
API_URL=https://api.rakta-daan.gov.np
WEB_URL=https://rakta-daan.gov.np

# Database (PostgreSQL - use your production database URL)
DATABASE_URL="postgresql://rakta:rakta@postgres:5432/rakta_daan"
DIRECT_DATABASE_URL="postgresql://rakta:rakta@postgres:5432/rakta_daan"

# Redis (use your production Redis URL)
REDIS_URL="redis://redis:6379"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Authentication (generate secure secrets for production)
JWT_SECRET="your-super-secure-jwt-secret-change-me"
JWT_REFRESH_SECRET="your-super-secure-refresh-secret-change-me"
OTP_PEPPER="your-otp-pepper-change-me"

# CORS (update with your production domains)
CORS_ORIGINS="https://rakta-daan.gov.np,https://www.rakta-daan.gov.np"

# SMS Provider (configure Sparrow SMS for Nepal)
SMS_PROVIDER="sparrow"
SPARROW_TOKEN="your-sparrow-api-token"
SPARROW_FROM="RAKTDAAN"

# Email Provider (configure Resend or similar)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_your-resend-api-key"

# WhatsApp Business API (configure Meta WhatsApp)
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"

# Development (set to false in production)
DEV_EXPOSE_OTP=false

# S3-Compatible Storage (for file uploads)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="ap-south-1"
S3_BUCKET="rakta-daan-uploads"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"

# Monitoring (optional)
SENTRY_DSN=""
LOG_LEVEL="info"
