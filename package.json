{
  "name": "rakta-daan",
  "version": "0.1.0",
  "private": true,
  "description": "Rakta-Daan: Nepal-first blood discovery and donor coordination website.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "outbox": "tsx scripts/dispatch-outbox.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dotenv": "17.2.4",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
