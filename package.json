{
  "name": "rakta-daan",
  "version": "0.1.0",
  "private": true,
  "description": "Rakta-Daan: Nepal-first blood discovery and donor coordination platform.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @rakta-daan/web dev",
    "dev:api": "pnpm --filter @rakta-daan/api start:dev",
    "dev:all": "concurrently \"pnpm dev:api\" \"pnpm dev\"",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @rakta-daan/web build",
    "build:api": "pnpm --filter @rakta-daan/api build",
    "start": "pnpm --filter @rakta-daan/web start",
    "start:api": "pnpm --filter @rakta-daan/api start:prod",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @rakta-daan/web test:e2e",
    "test:api": "pnpm --filter @rakta-daan/api test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @rakta-daan/api db:generate",
    "db:migrate": "pnpm --filter @rakta-daan/api db:migrate",
    "db:push": "pnpm --filter @rakta-daan/api db:push",
    "db:seed": "pnpm --filter @rakta-daan/web db:seed",
    "db:seed:demo": "pnpm --filter @rakta-daan/web db:seed:demo",
    "db:reset": "pnpm --filter @rakta-daan/web db:reset",
    "prisma:studio": "pnpm --filter @rakta-daan/api prisma:studio",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
